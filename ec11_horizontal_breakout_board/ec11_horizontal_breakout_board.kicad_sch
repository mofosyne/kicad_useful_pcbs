	(text "Dev Note: This breakout debounce approach is relying\n on the internal pullups of the microcontroller.\n\nIn this case, I am assuming it's an nrf52 where according \nto a forum discussion the internal pullups is around 14kOhms.\n\nI chose 100nF because it's a cheap capacitance value.\n\ndevzone.nordicsemi.com/f/nordic-q-a/107277/nrf52832-pull-up-pull-down-resistance\n"
		(exclude_from_sim no)
		(at 128.27 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "17254bbf-ea17-4bdd-9677-18a2c66feaa2")
	)
	(text "Debounce"
		(exclude_from_sim no)
		(at 86.106 16.256 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3f3dc031-58dc-4729-adb0-1480a485a772")
	)
	(text "For proper filtering\nhttps://www.bourns.com/docs/Product-Datasheets/PEC11R.pdf\n\nBourn has a recommended filtering schematic shown here:"
